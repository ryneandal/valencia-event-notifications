SMTP_USER=you@example.com
SMTP_APP_PASSWORD=your_smtp_app_password
RECIPIENT_EMAIL=family@example.com

# Cloudflare Worker magic-link delivery. Store the real value as the
# MAILGUN_API_KEY Worker secret before deployment; never commit it.
# MAILGUN_API_KEY=your_mailgun_domain_sending_key

# Subscriber source. Use sqlite for local development; production uses d1.
SUBSCRIBER_BACKEND=sqlite
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
# CLOUDFLARE_API_TOKEN=your_least_privilege_d1_read_token

# Choose one personalization backend: openrouter (default), gemini, or mistral.
LLM_BACKEND=openrouter

# Gemini personalization (used by the selection above)
GEMINI_API_KEY=your_gemini_api_key
# Optional backward-compatible alias:
# GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-2.5-pro

# Mistral personalization
# MISTRAL_API_KEY=your_mistral_api_key
# MISTRAL_MODEL=mistral-medium-2508
# MISTRAL_FALLBACK_MODEL=

# OpenRouter personalization. Model IDs use OpenRouter's provider/model format.
# OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_FALLBACK_MODEL=
# OPENROUTER_APP_URL=https://your-deployed-app.example
# OPENROUTER_APP_TITLE=Valencia Event Notifications

# Optional: override built-in family profile JSON
# FAMILY_PROFILE_JSON={"audience":"family_with_school_age_kids"}
